# Salin ke .env.staging (JANGAN di-commit). Secret dari secret manager staging,
# terpisah dari produksi (Spec §18.2/§19.6). Kosongkan Midtrans bila tidak diuji.
APP_HOST=app.umrovia.localhost
ADMIN_HOST=admin.umrovia.localhost
API_HOST=api.umrovia.localhost
# Port publik: lokal 8443 → ":8443"; staging sungguhan di 443 → kosongkan (PUBLIC_PORT_SUFFIX=).
HTTP_PORT=8080
HTTPS_PORT=8443
PUBLIC_PORT_SUFFIX=:8443
# "internal" = CA lokal Caddy; staging publik: email operator untuk ACME.
CADDY_TLS=internal
SECURE_HSTS_SECONDS=0

POSTGRES_PASSWORD=ganti-dengan-password-acak
SECRET_KEY=ganti-dengan-50-karakter-acak
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PII_ENCRYPTION_KEY=

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=Umrovia Staging <no-reply@umrovia.com>
MIDTRANS_SERVER_KEY=
WALLET_MANUAL_BANK_NAME=BANK STAGING
WALLET_MANUAL_ACCOUNT_NAME=PT Umrovia (staging)
WALLET_MANUAL_ACCOUNT_NUMBER=0000000000
