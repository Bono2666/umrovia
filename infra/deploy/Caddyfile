# Reverse proxy staging/produksi (Spec §18.1–18.2): TLS, host terpisah, header keamanan.
# CADDY_TLS=internal → CA lokal Caddy (uji lokal); isi email ACME untuk sertifikat publik.
# Host tak dikenal tidak dilayani: tanpa sertifikat → TLS gagal; Host ≠ SNI → 421 (strict_sni_host).

{
	servers {
		strict_sni_host on
	}
}

(security_headers) {
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy same-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		Cross-Origin-Opener-Policy same-origin
		-Server
	}
	# HSTS satu sumber untuk semua host (defer: menimpa header Django di API).
	# Rollout bertahap lewat SECURE_HSTS_SECONDS; tanpa preload (DEPLOY_ROLLBACK.md).
	header {
		Strict-Transport-Security "max-age={$HSTS_SECONDS:0}; includeSubDomains"
		defer
	}
}

# Situs marketing di domain utama: hanya halaman publik; rute aplikasi dialihkan ke host app.
{$SITE_HOST} {
	tls {$CADDY_TLS}
	import security_headers
	encode zstd gzip
	@app not path / /pricing /kontak /kebijakan-privasi /_next/* /brand/* /marketing/* /favicon.ico /icon.png /apple-icon.png
	redir @app https://{$APP_HOST}{$PUBLIC_PORT_SUFFIX}{uri} 308
	reverse_proxy web:3000
}

www.{$SITE_HOST} {
	tls {$CADDY_TLS}
	import security_headers
	redir https://{$SITE_HOST}{$PUBLIC_PORT_SUFFIX}{uri} 308
}

# Aplikasi travel & portal jamaah. Halaman marketing hanya ada di domain utama.
{$APP_HOST} {
	tls {$CADDY_TLS}
	import security_headers
	encode zstd gzip
	@root path /
	redir @root /login 302
	@marketing path /pricing /kontak /kebijakan-privasi
	redir @marketing https://{$SITE_HOST}{$PUBLIC_PORT_SUFFIX}{uri} 308
	reverse_proxy web:3000
}

# Konsol platform: host terpisah, tetapi otorisasi tetap di server (izin + MFA per endpoint).
{$ADMIN_HOST} {
	tls {$CADDY_TLS}
	import security_headers
	encode zstd gzip
	@root path /
	redir @root /platform 302
	reverse_proxy web:3000
}

{$API_HOST} {
	tls {$CADDY_TLS}
	import security_headers
	encode zstd gzip
	reverse_proxy api:8000 {
		header_up X-Forwarded-Proto https
	}
}
