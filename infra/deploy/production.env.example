# Produksi di VPS (docs/runbooks/FIRST_DEPLOY_VPS.md). Salin ke /srv/umrovia/.env.production,
# chmod 600, JANGAN di-commit. Simpan salinan SECRET_KEY, PII_ENCRYPTION_KEY dan password
# database di password manager: tanpa PII_ENCRYPTION_KEY, NIK/paspor jamaah tidak bisa dibaca lagi.

# Host publik (record A DNS semuanya → 103.87.66.228; www → CNAME ke domain utama)
# SITE_HOST = situs marketing; www.SITE_HOST otomatis dialihkan ke sana.
SITE_HOST=umrovia.com
APP_HOST=app.umrovia.com
ADMIN_HOST=admin.umrovia.com
API_HOST=api.umrovia.com
HTTP_PORT=80
HTTPS_PORT=443
PUBLIC_PORT_SUFFIX=
# Email operator untuk sertifikat Let's Encrypt (Caddy menerbitkan otomatis)
CADDY_TLS=email-operator@contoh.com
# Naikkan bertahap setelah HTTPS stabil (DEPLOY_ROLLBACK.md): 300 → 86400 → 31536000
# Berlaku untuk semua host lewat Caddy; ubah lalu `docker compose up -d api proxy`.
SECURE_HSTS_SECONDS=0

# Secret — buat dengan perintah di runbook bagian 4
POSTGRES_PASSWORD=
SECRET_KEY=
PII_ENCRYPTION_KEY=

# Email transaksional (SMTP penyedia, mis. Amazon SES/Mailgun/Postmark/Brevo)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Umrovia <no-reply@umrovia.com>
# Penerima pesan formulir kontak situs (wajib; kosong = pesan tersimpan tanpa notifikasi).
# Butuh kotak masuk sungguhan: umrovia.com memakai Zoho Mail (record MX di NEO DNS).
CONTACT_RECIPIENT_EMAIL=halo@umrovia.com

# Top-up SaaS Wallet manual (rekening penerima platform)
WALLET_MANUAL_BANK_NAME=
WALLET_MANUAL_ACCOUNT_NAME=
WALLET_MANUAL_ACCOUNT_NUMBER=
# Midtrans Snap (top-up SaaS Wallet). Sandbox: key SB-Mid-server-… + False.
# Produksi: key Mid-server-… dari dashboard Midtrans Production + True (lihat runbook bagian Midtrans).
MIDTRANS_SERVER_KEY=
MIDTRANS_IS_PRODUCTION=False
