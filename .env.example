# ==============================================================================
# Umrovia — environment template (S01/T09). Salin ke .env, isi nilai sesuai
# environment. JANGAN commit .env berisi secret sungguhan (Spec §19.6).
# ==============================================================================

# --- Core --------------------------------------------------------------------
# Wajib di semua environment selain local-DEBUG.
SECRET_KEY=
DEBUG=True
LOG_LEVEL=INFO

# --- Database (PostgreSQL — wajib, RLS aktif mulai F02) ----------------------
# Format: postgres://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgres://postgres@localhost:5432/umrovia
DB_SSL_REQUIRE=False

# --- Redis (Celery: email/PDF/reconcile — dipakai mulai F06/F07) -------------
REDIS_URL=redis://localhost:6379/0

# --- Host & origin (Spec §18.4) ----------------------------------------------
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:8000
CORS_ALLOWED_ORIGINS=http://localhost:3000
# SESSION_COOKIE_DOMAIN=   # host-only per default (Spec §18.2)

# --- URL publik per host (Spec §18.3/18.4) -----------------------------------
PUBLIC_SITE_URL=http://localhost:3001
TENANT_APP_URL=http://localhost:3000
PLATFORM_ADMIN_URL=http://localhost:3002
PUBLIC_API_URL=http://localhost:8000

# --- Brand & trial -----------------------------------------------------------
BRAND_NAME=Umrovia
TRIAL_DAYS=30

# --- Email (outbox + provider; console backend untuk local) ------------------
EMAIL_BACKEND=django.core.mail.backends.console.EMAIL_BACKEND
EMAIL_HOST=localhost
EMAIL_PORT=25
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=False
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=Umrovia <no-reply@umrovia.com>

# --- Object storage S3-compatible (dokumen jamaah, PDF — F05/F07) -----------
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=True

# --- Payment gateway (provider TBD — Spec §16) -------------------------------
PAYMENT_PROVIDER=
PAYMENT_MERCHANT_ID=
PAYMENT_API_KEY=
PAYMENT_WEBHOOK_SECRET=

# --- Production hardening ----------------------------------------------------
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=0
